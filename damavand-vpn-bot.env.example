BOT_TOKEN=replace-with-your-telegram-bot-token
ADMIN_IDS=123456789
CHANNEL_USERNAME=@your_channel
CHANNEL_ID=
CHANNEL_JOIN_URL=
SUPPORT_USERNAME=@your_support
DB_PATH=/var/lib/damavand-vpn-bot/bot.db
TERMS_FILE=/etc/damavand-vpn-bot/terms-fa.txt
TERMS_VERSION=1

XUI_BASE_URL=https://127.0.0.1:2053/your-panel-path
XUI_API_TOKEN=replace-with-your-panel-api-token
XUI_VERIFY_SSL=true
XUI_SUBSCRIPTION_BASE=https://example.com/sub

# Comma-separated IDs. Leave empty to attach to every enabled VLESS inbound.
XUI_INBOUND_IDS=
DEMO_MODE=false

# Card-to-card payments: set enabled only after adding your real recipient details.
CARD_PAYMENT_ENABLED=false
CARD_PAYMENT_CARD_NUMBER=
CARD_PAYMENT_HOLDER=
CARD_PAYMENT_INSTRUCTIONS=
